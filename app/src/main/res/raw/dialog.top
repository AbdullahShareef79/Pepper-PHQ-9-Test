topic: ~patientenaufnahme()# Konzepte

# Konzepte für Small Talk
concept:(hallo) ^rand["hallo" "hi" "hey" "guten Morgen" "grüß dich"]
concept:(wie-heißt-du) ["dein Name" "wie heißt du" "wie ist dein Name"]
concept:(wie-gehts) ["wie geht es dir" "wie fühlst du dich"]
concept:(gut-fühlen) ^rand["gut" "sehr gut" "prima" "okay" "super"]
concept:(schlecht-fühlen) ^rand["nicht gut" "schlecht" "müde"]
concept:(mein-name) ^rand["mein Name ist" "ich bin" "ich heiße"]
concept:(tschüss) ^rand["tschüss" "auf Wiedersehen" "bis bald"]
concept:(über-mich) ["erzähl etwas über dich" "wer bist du"]

# Patientenaufnahme-Konzepte
concept:(name) ["Name" "wie heißt du"]
concept:(geburtsdatum) ["Geburtsdatum" "wann bist du geboren"]
concept:(adresse) ["Adresse" "wo wohnst du"]
concept:(telefonnummer) ["Telefonnummer" "wie kann man dich erreichen"]
concept:(beruf) ["Beruf" "was machst du beruflich"]
concept:(krankenversicherung) ["Krankenversicherung" "welche Versicherung hast du"]
concept:(vorheriger-arzt) ["Hausarzt" "früherer Arzt"]
concept:(medizinische-vorgeschichte) ["medizinische Vorgeschichte" "frühere Krankheiten"]
concept:(familiengeschichte) ["Familienkrankheiten" "gibt es bekannte Krankheiten in deiner Familie"]
concept:(medikamente) ["Medikamente" "nimmst du regelmäßig Medikamente"]
concept:(allergien) ["Allergien" "bist du gegen etwas allergisch"]
concept:(impfpass) ["Impfpass" "hast du einen Impfpass"]
concept:(regelmäßige-medikamente) ["nimmst du regelmäßig Medikamente"]
concept:(arztbehandlung) ["bei welchem Arzt warst du in Behandlung"]
concept:(spezifische-krankheiten) ["Gelenkprobleme" "Magen-Darm-Erkrankungen" "Herz-Kreislauf-Erkrankungen" "Diabetes" "Blasen-Nieren-Probleme" "Lungenerkrankungen" "Krebserkrankungen" "Hautkrankheiten"]

# Regeln

# Begrüßung und Vorstellung
u:(~hallo) ~hallo ^nextProposal
u:(~wie-heißt-du) "Ich bin Pepper, dein virtueller Assistent."
u:(~mein-name _*) "Hallo $1, schön dich kennenzulernen!" $Name=$1
u:(~tschüss) ^first["~tschüss $Name" ~tschüss]
u:(~über-mich) "Ich bin Pepper und helfe dir bei deiner Patientenaufnahme. Lass uns loslegen."

# Patientenaufnahme Fragen
proposal: "Lass uns mit den grundlegenden Informationen beginnen. Wie ist dein vollständiger Name?"
  u1:(_*) "Danke! Und dein Geburtsdatum?" ^nextProposal

proposal: "Was ist deine Adresse?"
  u1:(_*) "Verstanden. Und deine Telefonnummer?" ^nextProposal

proposal: "Welchen Beruf übst du aus?"
  u1:(_*) "Danke! Hast du eine Krankenversicherung? Wenn ja, welche?" ^nextProposal

proposal: "Wer war dein vorheriger Arzt?"
  u1:(_*) "Verstanden. Lass uns nun über deine Gesundheit sprechen. Hattest du frühere Krankheiten oder Behandlungen?" ^nextProposal

proposal: "Kommen in deiner Familie oder bei dir selbst Krankheiten wie Gelenkprobleme, Magen-Darm-Erkrankungen, Nierenprobleme, Herz-Kreislauf-Erkrankungen, Diabetes, Lungenerkrankungen, Hautkrankheiten oder Krebs vor?"
  u1:(_*) "Danke für die Information. Die Familiengeschichte kann wichtig für deine Gesundheit sein." ^nextProposal

proposal: "Nimmst du regelmäßig Medikamente?"
  u1:(_*) "Okay. Hast du bekannte Allergien?" ^nextProposal

proposal: "Besitzt du einen Impfpass?"
  u1:(["ja" "yep"]) "Super! Bitte bring ihn zu deinem Termin mit."
  u1:(["nein" "nope"]) "Kein Problem. Wir werden deine Angaben entsprechend aktualisieren." ^nextProposal

proposal: "Das war’s erstmal! Vielen Dank für deine Antworten. Falls du noch Fragen hast, lass es mich wissen."
  u1:(~tschüss) "Mach’s gut, $Name! Ich bin da, falls du noch Hilfe brauchst."

