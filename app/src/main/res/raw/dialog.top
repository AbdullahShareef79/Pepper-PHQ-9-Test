topic: ~patient_questionnaire()

# Basic greetings and responses
concept:(hello) [hello hi hey "good morning" greetings hallo "guten tag" "guten morgen"]
concept:(yes) [yes yeah ja jawohl "ja klar" "natürlich"]
concept:(no) [no nein "nee" "nicht"]

# Greetings
u:(~hello) ~hello! Ich bin Pepper. Kann ich Ihnen mit dem Patientenfragebogen helfen?

# Starting the questionnaire
u:(["Ich möchte den Fragebogen ausfüllen" "Fragebogen" "starte den Fragebogen" "ich bin ein neuer Patient"])
    Guten Tag! Ich werde Ihnen einige Fragen stellen, um Sie besser kennen zu lernen. Bitte beantworten Sie die Fragen zu Ihrem Gesundheitsstatus. Sind Sie bereit?

# Confirmation to start
u:(~yes)
    Ausgezeichnet! Beginnen wir mit dem Fragebogen.
    ^start(questionnaire)

# Handle questionnaire questions
proposal: %questionnaire
    Wie ist Ihr Nachname?

u:(_*)
    ^bookmark(collect_nachname, $1)
    Verstanden. Wie ist Ihr Vorname?

u:(_*)
    ^bookmark(collect_vorname, $1)
    Alles klar. Wann haben Sie Geburtstag?

u:(_*)
    ^bookmark(collect_geburtstag, $1)
    Danke. Wie lautet Ihre Anschrift?

u:(_*)
    ^bookmark(collect_anschrift, $1)
    Verstanden. Wie ist Ihre Telefonnummer?

u:(_*)
    ^bookmark(collect_telefon, $1)
    Danke. Was ist Ihr Beruf?

u:(_*)
    ^bookmark(collect_beruf, $1)
    Verstanden. Wie heißt Ihre Krankenversicherung?

u:(_*)
    ^bookmark(collect_versicherung, $1)
    Danke. Wer war Ihr ehemaliger Hausarzt?

u:(_*)
    ^bookmark(collect_hausarzt, $1)
    Verstanden. Bei welchem Arzt waren Sie vorher in Behandlung?

u:(_*)
    ^bookmark(collect_vorbehandlung, $1)
    Danke. Jetzt komme ich zu Fragen über Ihre Gesundheit. Haben Sie Rücken- oder Gelenkserkrankungen?

u:(~yes)
    ^bookmark(collect_ruecken, ja)
    Haben Sie Erkrankungen der Blase oder Nieren?

u:(~no)
    ^bookmark(collect_ruecken, nein)
    Haben Sie Erkrankungen der Blase oder Nieren?

u:(~yes)
    ^bookmark(collect_blase, ja)
    Haben Sie Herz-Kreislauferkrankungen?

u:(~no)
    ^bookmark(collect_blase, nein)
    Haben Sie Herz-Kreislauferkrankungen?

u:(~yes)
    ^bookmark(collect_herz, ja)
    Haben Sie Stoffwechselerkrankungen?

u:(~no)
    ^bookmark(collect_herz, nein)
    Haben Sie Stoffwechselerkrankungen?

u:(~yes)
    ^bookmark(collect_stoffwechsel, ja)
    Haben Sie Magen-Darm-Erkrankungen?

u:(~no)
    ^bookmark(collect_stoffwechsel, nein)
    Haben Sie Magen-Darm-Erkrankungen?

u:(~yes)
    ^bookmark(collect_magen, ja)
    Haben Sie Hauterkrankungen?

u:(~no)
    ^bookmark(collect_magen, nein)
    Haben Sie Hauterkrankungen?

u:(~yes)
    ^bookmark(collect_haut, ja)
    Haben Sie Lungenerkrankungen?

u:(~no)
    ^bookmark(collect_haut, nein)
    Haben Sie Lungenerkrankungen?

u:(~yes)
    ^bookmark(collect_lunge, ja)
    Haben Sie Krebserkrankungen?

u:(~no)
    ^bookmark(collect_lunge, nein)
    Haben Sie Krebserkrankungen?

u:(~yes)
    ^bookmark(collect_krebs, ja)
    Haben Sie sonstige Erkrankungen?

u:(~no)
    ^bookmark(collect_krebs, nein)
    Haben Sie sonstige Erkrankungen?

u:(~yes)
    Welche sonstigen Erkrankungen haben Sie?

u:(_*)
    ^bookmark(collect_sonstige, $1)
    Nehmen Sie regelmäßig Medikamente ein?

u:(~no)
    ^bookmark(collect_sonstige, keine)
    Nehmen Sie regelmäßig Medikamente ein?

u:(~yes)
    Welche Medikamente nehmen Sie ein?

u:(_*)
    ^bookmark(collect_medikamente, $1)
    Leiden Sie an Allergien?

u:(~no)
    ^bookmark(collect_medikamente, keine)
    Leiden Sie an Allergien?

u:(~yes)
    Gegen welche Allergien leiden Sie?

u:(_*)
    ^bookmark(collect_allergien, $1)
    Besitzen Sie einen Impfausweis?

u:(~no)
    ^bookmark(collect_allergien, keine)
    Besitzen Sie einen Impfausweis?

u:(~yes)
    ^bookmark(collect_impfausweis, ja)
    Vielen Dank für die Beantwortung aller Fragen! Wir werden diese Informationen für Ihre Behandlung verwenden. Einen schönen Tag noch!

u:(~no)
    ^bookmark(collect_impfausweis, nein)
    Vielen Dank für die Beantwortung aller Fragen! Wir werden diese Informationen für Ihre Behandlung verwenden. Einen schönen Tag noch!

# Handle general robot questions during the process
u:(wie heißt du)
    Mein Name ist Pepper! Können wir jetzt mit dem Fragebogen fortfahren?

u:(wo arbeitest du)
    Ich arbeite hier in der Praxis und helfe bei der Aufnahme von Patientendaten. Können wir jetzt mit dem Fragebogen fortfahren?

u:(was kannst du)
    Ich kann Ihnen helfen, den Patientenfragebogen auszufüllen. Möchten wir fortfahren?

# Cancel questionnaire
u:(["abbrechen" "stop" "hör auf" "beenden"])
    Ich beende den Fragebogen. Wenn Sie später weitermachen möchten, lassen Sie es mich wissen.
